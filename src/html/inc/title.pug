#title
  h1.brand 辽宁穷胡
  .subtitle 四人麻将 · 人机对战
  if page == 'autoplay'
    div 自动对战演示
  if page == 'netplay'
    div 网络对战
  .version ver. #{version}
  .loading 加载中…
  .start.hide(tabindex="0" role="button") 开始对局
  if page == 'netplay'
    .login.hide
      form.local(method="POST" action="server/auth/")
        input(name="name" placeholder="玩家名")
        input(name="passwd" value="*" type="hidden")
        input(type="submit" value="注册")
      form.hatena(method="POST" action="server/auth/hatena")
        .logo
        input(type="submit" value="Hatena登录")
      form.google(method="POST" action="server/auth/google")
        .logo
        input(type="submit" value="Google登录")
