body.title
    color:      #f2efe6
    background: radial-gradient(ellipse at 50% 20%, #2a4a38 0%, #0c1a12 55%, #06100a 100%)
    margin: 0
    min-height: 100vh
    #title
        display: block
    #navi
        width: 800px
        margin: 0 auto
    > .version
        display: none

#title
    display: none
    margin: 48px auto
    width: 640px
    padding: 28px 24px 32px
    border: 1px solid rgba(212, 175, 55, 0.4)
    background: linear-gradient(165deg, rgba(26, 58, 42, 0.92), rgba(12, 28, 20, 0.96))
    color:      #f2efe6
    text-align: center
    font-family: "Noto Serif SC", "Source Han Serif SC", "Songti SC", STSong, serif
    box-shadow: 0 12px 40px rgba(0, 0, 0, 0.45)
    h1.brand
        margin: 0 0 8px
        height: auto
        font-size: 64px
        font-weight: 700
        letter-spacing: 0.2em
        color: #e8c547
        text-shadow: 0 2px 0 #3a2a08
        img
            width: 600px
    .subtitle
        margin: 0 0 16px
        font-size: 16px
        letter-spacing: 0.18em
        color: #9ad4b0
    .version
        font-family: Georgia, serif
        font-size: 14px
        color: #a89f8c
    .loading
        margin: 8px auto
        color: #a89f8c
        font-family: "PingFang SC", "Microsoft YaHei", sans-serif
        font-size: 16px
        animation: blink-text 2s infinite
    .start
        margin: 16px auto 8px
        font-family: "Noto Serif SC", "Songti SC", serif
        width: 160px
        padding: 10px 4px
        border: 1px solid #e8c547
        font-size: 18px
        letter-spacing: 0.15em
        color: #1a2e22
        background: linear-gradient(180deg, #f0d878, #c9a227)
        cursor: pointer
        &:hover
        &:focus
            background: linear-gradient(180deg, #ffe9a0, #e8c547)
            outline: none
    .login
        margin: 8px auto
        form
            margin: 0.5em
        input[type="submit"]
            cursor: pointer
        form.local
            input[name="name"]
                width: 8em
            input[type="submit"]
                border: none
                color: white
                background: blue
        form:not(.local)
            input[type="submit"]
                width: 120px
                border: none
                background: none
                text-align: left
                padding: 0
        .logo
            display: inline-block
            width: 1.2em
            height: 1.2em
            vertical-align: text-bottom
            background-size: cover
        .hatena .logo
            background-image: url(https://www.hatena.ne.jp/p/images/favicon.ico)
        .google .logo
            background-image: url(https://www.google.com/favicon.ico)
